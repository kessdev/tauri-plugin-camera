{
  "gitSiteUrl": "https://github.com/kessdev/tauri-plugin-camera/",
  "pkgManagers": {
    "rust": {
      "version": true,
      "getPublishedVersion": {
        "use": "fetch:check",
        "options": {
          "url": "https://crates.io/api/v1/crates/${ pkg.pkgFile.pkg.package.name }/${ pkg.pkgFile.version }"
        }
      },
      "publish": "cargo publish --no-verify"
    },
    "javascript": {
      "version": true,
      "getPublishedVersion": {
        "use": "fetch:check",
        "options": {
          "url": "https://registry.npmjs.com/${ pkg.pkgFile.pkg.name }/${ pkg.pkgFile.version }"
        }
      },
      "publish": "npm publish --access public"
    }
  },
  "packages": {
    "tauri-plugin-camera-kessdev": {
      "path": "./",
      "manager": "rust"
    },
    "tauri-plugin-camera-kessdev-js": {
      "path": "./",
      "manager": "javascript"
    }
  }
}
